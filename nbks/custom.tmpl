<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="./favicon.ico">
    <style type="text/css">
      /* Shared by every notebook. It sets no colours and no cursor,
         so each notebook keeps the look of the theme declared in its
         own <notebook theme="...">. Anything specific to one page
         (colours, #field, .spel, ...) goes in a <style> in that
         notebook's own html cell: see nbks/index.html. The font
         imports below are the kit's --serif font; they cost nothing
         for a page that doesn't use var(--serif). */
      @import url("observable:styles/index.css");
      @import url("@fontsource-variable/source-serif-4/opsz.css");
      @import url("@fontsource-variable/source-serif-4/opsz-italic.css");

      /* The page chrome below applies only to a page that has the
         element #field (the player, index.html). A scoring notebook,
         such as scoring-*.html, keeps the kit's chrome as well as its
         theme. :where() keeps each rule at the specificity it would
         have without the scope, so a page's own <style> can still
         override it. */

      /* neutralise the kit's page chrome, then give the page one
         small, equal margin left and right (so the page's centre
         doesn't move). A page can change it in its own <style>, e.g.
         body { --page-margin: 6vw } */
      :root {
        --page-margin: 2vw;
      }
      html:where(:has(#field)), body:where(:has(#field)) {
        margin: 0;
      }
      body:where(:has(#field)) {
        box-sizing: border-box;
        padding: 0 var(--page-margin);
      }
      :where(body:has(#field)) main {
        margin-inline: auto;
        max-width: none;
      }
    </style>
  </head>
  <body>
    <main></main>
  </body>
</html>
