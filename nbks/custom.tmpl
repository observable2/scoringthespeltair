<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <link rel="icon" type="image/x-icon" href="./favicon.ico">
    <style type="text/css">
      /* Shared by every notebook. It sets no colours and no cursor, so each notebook keeps the
         look of the theme declared in its own <notebook theme="..."> (the kit appends that
         theme's stylesheet after this one, so a colour set here on :root would lose anyway).
         Anything specific to one page (colours, #field, .spel, ...) goes in a <style> in that
         notebook's own html cell: see nbks/index.html. The font imports below are the
         kit's --serif font; they cost nothing for a page that doesn't use var(--serif). */
      @import url("observable:styles/index.css");
      @import url("@fontsource-variable/source-serif-4/opsz.css");
      @import url("@fontsource-variable/source-serif-4/opsz-italic.css");

      /* neutralise the kit's page chrome (body margin/padding, <main> max-width) */
      html, body {
        margin: 0;
        padding: 0;
      }
      main {
        margin: 0;
        max-width: none;
      }
    </style>
  </head>
  <body>
    <main></main>
  </body>
</html>
